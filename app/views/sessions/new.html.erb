<% content_for :title, "Sign in" %>
<section class="card narrow">
  <h1>Sign in</h1>
  <%= form_with url: session_path, class: "stack" do |form| %>
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    <%= form.submit "Sign in", class: "button" %>
  <% end %>
  <p class="muted">New here? <%= link_to "Create an account", new_registration_path %> · <%= link_to "Forgot password?", new_password_path %></p>
</section>
